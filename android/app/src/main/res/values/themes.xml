<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WallScanner" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/tape</item>
        <item name="colorPrimaryVariant">@color/tape</item>
        <item name="colorOnPrimary">@color/wall</item>
        <item name="colorSecondary">@color/tape</item>
        <item name="colorOnSecondary">@color/wall</item>
        <item name="colorSurface">@color/panel</item>
        <item name="colorOnSurface">@color/chalk</item>
        <item name="colorOnBackground">@color/chalk</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/wall</item>
        <item name="android:windowBackground">@color/wall</item>
        <item name="android:statusBarColor">@color/wall</item>
        <item name="android:navigationBarColor">@color/wall</item>
        <item name="android:textColorPrimary">@color/chalk</item>
        <item name="android:textColorSecondary">@color/dust</item>
        <item name="android:textColorHint">@color/dust</item>
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:listDivider">@color/hairline</item>
        <item name="materialButtonStyle">@style/Widget.WallScanner.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.WallScanner.Button.Outlined</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.WallScanner.Dialog</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.WallScanner.Title</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.WallScanner.Body</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.WallScanner.Strong</item>
        <item name="textAppearanceBody1">@style/TextAppearance.WallScanner.Body</item>
        <item name="textAppearanceBody2">@style/TextAppearance.WallScanner.Meta</item>
    </style>

    <style name="TextAppearance.WallScanner.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/chalk</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.WallScanner.Strong" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/chalk</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.WallScanner.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/chalk</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.WallScanner.Meta" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/dust</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Filled button: the one tape-coloured element on a screen, so only the primary action uses it. -->
    <style name="Widget.WallScanner.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@color/tape</item>
        <item name="android:textColor">@color/wall</item>
        <item name="rippleColor">@color/wall</item>
    </style>

    <!-- Outlined button: secondary actions and the mode switch (checked = tape stroke and wash). -->
    <style name="Widget.WallScanner.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/toggle_stroke</item>
        <item name="backgroundTint">@color/toggle_background</item>
        <item name="android:textColor">@color/toggle_text</item>
        <item name="rippleColor">@color/tape_wash</item>
    </style>

    <style name="Widget.WallScanner.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/tape</item>
        <item name="rippleColor">@color/tape_wash</item>
    </style>

    <style name="ThemeOverlay.WallScanner.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:background">@color/panel</item>
        <item name="colorPrimary">@color/tape</item>
        <item name="colorSecondary">@color/tape</item>
        <item name="colorSurface">@color/panel</item>
        <item name="colorOnSurface">@color/chalk</item>
        <item name="android:textColorPrimary">@color/chalk</item>
        <item name="android:textColorSecondary">@color/dust</item>
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.WallScanner.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.WallScanner.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.WallScanner.DialogButton</item>
    </style>
</resources>
