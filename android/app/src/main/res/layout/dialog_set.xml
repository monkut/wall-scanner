<?xml version="1.0" encoding="utf-8"?>
<!-- New set / Edit set: the set's name, the walls it covers (gyms with registered walls), and (when editing) whether the wall has been reset. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBody2"
        android:text="@string/set_name_label" />

    <EditText
        android:id="@+id/setName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/set_name_hint"
        android:inputType="textCapWords"
        android:importantForAutofill="no" />

    <!-- One CheckBox per registered wall is added here at runtime; hidden when the gym has no walls. -->
    <LinearLayout
        android:id="@+id/setWalls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBody2"
            android:text="@string/set_walls_label" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/setRetired"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/set_retired_checkbox" />
</LinearLayout>
