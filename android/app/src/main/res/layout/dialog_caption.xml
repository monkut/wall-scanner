<?xml version="1.0" encoding="utf-8"?>
<!-- Settings → Caption: on/off, the corner it sits in, and its font (each choice shown in its own typeface). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp">

        <CheckBox
            android:id="@+id/captionOn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/caption_show" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBody2"
            android:text="@string/caption_corner" />

        <RadioGroup
            android:id="@+id/captionCorner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/cornerUpperLeft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/corner_upper_left" />

            <RadioButton
                android:id="@+id/cornerUpperRight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/corner_upper_right" />

            <RadioButton
                android:id="@+id/cornerLowerLeft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/corner_lower_left" />

            <RadioButton
                android:id="@+id/cornerLowerRight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/corner_lower_right" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBody2"
            android:text="@string/caption_font" />

        <!-- One RadioButton per CaptionFont is added here at runtime, set in that font. -->
        <RadioGroup
            android:id="@+id/captionFont"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
